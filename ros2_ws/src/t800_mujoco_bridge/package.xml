<?xml version="1.0"?>
<package format="3">
  <name>t800_mujoco_bridge</name>
  <version>0.1.0</version>
  <description>Bridge EngineAI MuJoCo state and control between LCM and ROS 2.</description>
  <maintainer email="llkj09203-collab@users.noreply.github.com">llkj09203-collab</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
