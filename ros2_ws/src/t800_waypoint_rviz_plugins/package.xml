<?xml version="1.0"?>
<package format="3">
  <name>t800_waypoint_rviz_plugins</name>
  <version>0.1.0</version>
  <description>RViz control panel for T800 waypoint editing and missions.</description>
  <maintainer email="llkj09203-collab@users.noreply.github.com">llkj09203-collab</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>rviz_default_plugins</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/plugins_description.xml"/>
  </export>
</package>
