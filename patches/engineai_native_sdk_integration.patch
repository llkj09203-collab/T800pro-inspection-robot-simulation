@@ -0,0 +1,90 @@
+#pragma once
+
+#include <chrono>
+#include <cmath>
+#include <cstdlib>
+#include <memory>
+#include <iomanip>
+#include <locale>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <lcm/lcm-cpp.hpp>
+#include "gamepad_info/gamepad_info.h"
+#include "lcm_param/lcm_param.h"
+#include "variant_store/variant_store.h"
+
+namespace runner {
+// Explicit opt-in for the simulation experiment; no change to normal SDK operation.
+// Wire protocol used by the ROS 2 MuJoCo bridge and simulator integration.
+class LidarCommandGate {
+ public:
+  LidarCommandGate() {
+    const char* enabled = std::getenv("ENGINEAI_LIDAR_CONTROL");
+    enabled_ = enabled && std::string(enabled) == "1";
+    if (!enabled_) return;
+    data::LcmParam param;
+    lcm_ = std::make_unique<lcm::LCM>("udpm://" + param.ip_port + "?ttl=" +
+                                   std::to_string(param.multicast ? param.ttl : 0));
+    if (lcm_->good()) {
+      lcm_->subscribe("lidar/control", &LidarCommandGate::Receive, this)->setQueueCapacity(1);
+    }
+  }
+
+  void Apply(data::GamepadInfo& input, const std::string& motion) {
+    if (!enabled_) return;
+    if (lcm_->good()) {
+      for (int i = 0; i < 4 && lcm_->handleTimeout(0) > 0; ++i) {}
+    }
+    const double now = SteadySeconds();
+    const bool stop = stop_ || now - received_ > 0.5 || !lcm_->good();
+    // Digital keys stay available for stand/walk/passive transitions.
+    input.LeftStick_X = stop ? 0.0 : forward_;
+    input.LeftStick_Y = 0.0;
+    input.RightStick_X = 0.0;
+    input.RightStick_Y = stop ? 0.0 : yaw_;
+    data::VariantStore::GetInstance().Set("lidar/gate", std::make_pair(now, stop));
+    if (now - last_status_ >= 0.1 && lcm_->good()) {
+      last_status_ = now;
+      // Motion task names are fixed by SDK configuration; quote only known walk state.
+      std::ostringstream out;
+      out.imbue(std::locale::classic());
+      const double wall = std::chrono::duration<double>(
+          std::chrono::system_clock::now().time_since_epoch()).count();
+      out << std::setprecision(16) << "{\"version\":1,\"stamp\":" << wall
+          << ",\"stop\":" << (stop ? "true" : "false")
+          << ",\"walk\":" << (motion == "walk" ? "true" : "false")
+          << ",\"forward\":" << input.LeftStick_X << ",\"yaw\":" << input.RightStick_Y << "}";
+      const auto bytes = out.str();
+      lcm_->publish("lidar/gate_status", bytes.data(), bytes.size());
+    }
+  }
+
+ private:
+  static double SteadySeconds() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+  }
+  void Receive(const lcm::ReceiveBuffer* buffer, const std::string&) {
+    if (buffer->data_size > 160) return;
+    std::istringstream in(std::string(static_cast<const char*>(buffer->data), buffer->data_size));
+    in.imbue(std::locale::classic());
+    std::string version, trailing;
+    double stamp, forward, yaw;
+    int stop;
+    if (!(in >> version >> stamp >> forward >> yaw >> stop) || (in >> trailing)) return;
+    const double wall = std::chrono::duration<double>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    if (version != "LIDAR1" || !std::isfinite(stamp) || !std::isfinite(forward) ||
+        !std::isfinite(yaw) || std::abs(forward) > 0.7 || std::abs(yaw) > 1.0 ||
+        (stop != 0 && stop != 1) || wall - stamp > 0.5 || stamp - wall > 0.1 || stamp <= stamp_) return;
+    stamp_ = stamp;
+    received_ = SteadySeconds();
+    forward_ = forward;
+    yaw_ = yaw;
+    stop_ = stop != 0;
+  }
+  bool enabled_ = false, stop_ = true;
+  double received_ = -1e30, stamp_ = 0, last_status_ = 0, forward_ = 0, yaw_ = 0;
+  std::unique_ptr<lcm::LCM> lcm_;
+};
+}  // namespace runner
