diff --git a/simulation/mujoco/lidar_bridge.h b/simulation/mujoco/lidar_bridge.h
new file mode 100644
index 0000000..70d7d00
--- /dev/null
+++ b/simulation/mujoco/lidar_bridge.h
@@ -0,0 +1,333 @@
+#pragma once
+
+#include <mujoco/mujoco.h>
+#include <lcm/lcm-cpp.hpp>
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <iomanip>
+#include <locale>
+#include <sstream>
+#include <string>
+#include <vector>
+#include "lcm_param/lcm_param.h"
+
+// Physics-thread snapshot/placement bridge. CPU ray casting runs in a separate
+// process against these authoritative states; that process never advances physics.
+class LidarBridge {
+ public:
+  explicit LidarBridge(const data::LcmParam& param)
+      : lcm_("udpm://" + param.ip_port + "?ttl=" + std::to_string(param.multicast ? param.ttl : 0)) {
+    lcm_.subscribe("lidar/place", &LidarBridge::Place, this)->setQueueCapacity(1);
+    lcm_.subscribe("lidar/reset", &LidarBridge::Reset, this)->setQueueCapacity(1);
+    lcm_.subscribe("lidar/rays_debug", &LidarBridge::DebugRays, this)->setQueueCapacity(1);
+    if (const char* value = std::getenv("ENGINEAI_LIDAR_IMU_RATE_HZ")) {
+      char* end = nullptr;
+      const double requested = std::strtod(value, &end);
+      if (end != value && *end == '\0' && std::isfinite(requested) &&
+          requested >= 20.0 && requested <= 350.0) {
+        imu_rate_hz_ = requested;
+      }
+    }
+  }
+
+  ~LidarBridge() {
+    if (debug_scene_initialized_) mjv_freeScene(&debug_scene_);
+  }
+
+  mjvScene* DebugScene() { return &debug_scene_; }
+
+  // Called before every physics step. Placement happens in this same world.
+  void BeforeStep(const mjModel* model, mjData* data) {
+    model_ = model;
+    data_ = data;
+    if (initial_qpos_.empty()) {
+      initial_qpos_.assign(data->qpos, data->qpos + model->nq);
+      initial_mocap_pos_.assign(data->mocap_pos, data->mocap_pos + 3 * model->nmocap);
+      initial_mocap_quat_.assign(data->mocap_quat, data->mocap_quat + 4 * model->nmocap);
+    }
+    for (int i = 0; i < 4 && lcm_.handleTimeout(0) > 0; ++i) {}
+    if (pending_reset_ > 0 && !initial_qpos_.empty()) {
+      const int sequence = pending_reset_;
+      pending_reset_ = 0;
+      mj_resetData(model, data);
+      mju_copy(data->qpos, initial_qpos_.data(), model->nq);
+      if (model->nmocap > 0) {
+        mju_copy(data->mocap_pos, initial_mocap_pos_.data(), 3 * model->nmocap);
+        mju_copy(data->mocap_quat, initial_mocap_quat_.data(), 4 * model->nmocap);
+      }
+      mj_forward(model, data);
+      last_sim_ = -1e30;
+      last_wall_ = 0;
+      // mj_resetData rewinds simulation time.  Reset both sides of the IMU
+      // scheduler as well; otherwise next_imu_sim_ remains in the previous
+      // timeline and suppresses IMU publication until that time is reached.
+      next_imu_sim_ = data->time;
+      last_imu_sim_ = -1e30;
+      last_imu_wall_ = 0;
+      const std::string ack = "RESET_ACK1 " + std::to_string(sequence);
+      lcm_.publish("lidar/reset_ack", ack.data(), ack.size());
+    }
+    // Explicit visualization-only mode. During the normal startup hold this
+    // animates the real T800 Pro head joints without enabling walking control.
+    const char* sweep = std::getenv("ENGINEAI_LIDAR_HEAD_SWEEP");
+    if (sweep && std::string(sweep) == "1") {
+      const int pitch = mj_name2id(model, mjOBJ_JOINT, "J41_HEAD_PITCH");
+      const int yaw = mj_name2id(model, mjOBJ_JOINT, "J42_HEAD_YAW");
+      if (pitch >= 0 && yaw >= 0) {
+        if (sweep_start_ <= 0) sweep_start_ = WallSeconds();
+        const double elapsed = WallSeconds() - sweep_start_;
+        data->qpos[model->jnt_qposadr[pitch]] = 0.10 * std::sin(0.25 * elapsed);
+        data->qpos[model->jnt_qposadr[yaw]] = 0.52 * std::sin(0.50 * elapsed);
+        data->qvel[model->jnt_dofadr[pitch]] = 0;
+        data->qvel[model->jnt_dofadr[yaw]] = 0;
+        mj_forward(model, data);
+      }
+    }
+  }
+
+  void AfterStep(const mjModel* model, mjData* data) {
+    const double wall = WallSeconds();
+    if (data->time < last_sim_) {
+      last_sim_ = -1e30;
+      next_imu_sim_ = data->time;
+    }
+    PublishHeadImu(model, data, wall);
+    // While headless simulation waits for SDK position control, simulation
+    // time is intentionally frozen. Still publish the stationary sensor pose
+    // at wall-clock rate so perception can become ready before walking starts.
+    if (data->time >= last_sim_ && data->time - last_sim_ < 0.1 &&
+        wall - last_wall_ < 0.1) return;
+    last_sim_ = data->time;
+    last_wall_ = wall;
+    // The stage-3 depth camera is used only as the rigid lidar mount frame here.
+    const int sensor_mount = mj_name2id(model, mjOBJ_CAMERA, "depth");
+    const int base = mj_name2id(model, mjOBJ_BODY, "LINK_BASE");
+    const int head_pitch = mj_name2id(model, mjOBJ_BODY, "LINK_HEAD_PITCH");
+    const int head_yaw = mj_name2id(model, mjOBJ_BODY, "LINK_HEAD_YAW");
+    const int head_imu = mj_name2id(model, mjOBJ_SITE, "o2s_imu");
+    const int scene = mj_name2id(model, mjOBJ_TEXT, "lidar_scenario");
+    if (sensor_mount < 0 || base < 0 || head_pitch < 0 || head_yaw < 0 || head_imu < 0) return;
+    const std::string scenario = scene < 0
+        ? "default"
+        : std::string(model->text_data + model->text_adr[scene]);
+    if (scenario != "default" && scenario != "wall" && scenario != "scan" && scenario != "sudden" &&
+        scenario != "stage3_office" && scenario != "stage3_warehouse" &&
+        scenario != "stage3_mixed") return;
+    const int box = mj_name2id(model, mjOBJ_BODY, "sudden_obstacle");
+    const int mocap = box < 0 ? -1 : model->body_mocapid[box];
+    const bool placed = mocap >= 0 && data->mocap_pos[3*mocap+2] > 0;
+    bool scenario_collision = false;
+    for (int i = 0; i < data->ncon; ++i) {
+      const int g1 = data->contact[i].geom1;
+      const int g2 = data->contact[i].geom2;
+      if ((model->geom_group[g1] == 5) != (model->geom_group[g2] == 5)) {
+        scenario_collision = true;
+        break;
+      }
+    }
+    mj_kinematics(model, data);
+    mj_camlight(model, data);
+    UpdateDebugScene(model, data, sensor_mount, wall);
+    const mjtNum* p = data->xpos + 3 * base;
+    const mjtNum* r = data->xmat + 9 * base;
+    std::ostringstream out;
+    out.imbue(std::locale::classic());
+    out << std::setprecision(16) << "{\"version\":3,\"scenario\":\"" << scenario
+        << "\",\"native_version\":\"" << mj_versionString() << "\",\"stamp\":" << wall
+        << ",\"sim_time\":" << data->time << ",\"pose\":[" << p[0] << ',' << p[1] << ','
+        << std::atan2(r[3], r[0]) << "],\"height\":" << p[2] << ",\"upright\":" << r[8]
+        << ",\"placed\":" << (placed ? "true" : "false")
+        << ",\"collision\":" << (scenario_collision ? "true" : "false")
+        << ",\"ngeom\":" << model->ngeom;
+    const auto array = [&out](const char* name, const mjtNum* values, int count) {
+      out << ",\"" << name << "\":[";
+      for (int i = 0; i < count; ++i) {
+        if (i) out << ',';
+        out << values[i];
+      }
+      out << ']';
+    };
+    array("origin", data->cam_xpos + 3*sensor_mount, 3);
+    array("sensor_matrix", data->cam_xmat + 9*sensor_mount, 9);
+    array("base_origin", data->xpos + 3*base, 3);
+    array("base_matrix", data->xmat + 9*base, 9);
+    array("head_pitch_origin", data->xpos + 3*head_pitch, 3);
+    array("head_pitch_matrix", data->xmat + 9*head_pitch, 9);
+    array("head_yaw_origin", data->xpos + 3*head_yaw, 3);
+    array("head_yaw_matrix", data->xmat + 9*head_yaw, 9);
+    array("head_imu_origin", data->site_xpos + 3*head_imu, 3);
+    array("head_imu_matrix", data->site_xmat + 9*head_imu, 9);
+    array("qpos", data->qpos, model->nq);
+    array("qvel", data->qvel, model->nv);
+    array("mocap_pos", data->mocap_pos, 3*model->nmocap);
+    array("mocap_quat", data->mocap_quat, 4*model->nmocap);
+    // Mirror runtime edits to the scenario obstacle geometry as well as mocap.
+    out << ",\"geoms\":[";
+    bool first = true;
+    for (int g = 0; g < model->ngeom; ++g) {
+      if (model->geom_group[g] != 5) continue;
+      if (!first) out << ',';
+      first = false;
+      out << '[' << g;
+      for (int i = 0; i < 3; ++i) out << ',' << model->geom_pos[3*g+i];
+      for (int i = 0; i < 4; ++i) out << ',' << model->geom_quat[4*g+i];
+      for (int i = 0; i < 3; ++i) out << ',' << model->geom_size[3*g+i];
+      out << ']';
+    }
+    out << "]}";
+    const auto bytes = out.str();
+    lcm_.publish("lidar/state", bytes.data(), bytes.size());
+  }
+
+ private:
+  static double WallSeconds() {
+    return std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+  }
+  void UpdateDebugScene(const mjModel* model, const mjData* data,
+                        int sensor_mount, double wall) {
+    if (!debug_scene_initialized_) {
+      mjv_defaultScene(&debug_scene_);
+      mjv_makeScene(model, &debug_scene_, 500);
+      debug_scene_initialized_ = true;
+    }
+    if (wall - debug_rays_stamp_ > 0.5 || debug_ray_endpoints_.empty()) {
+      debug_scene_.ngeom = 0;
+      return;
+    }
+    const int count = std::min<int>(debug_ray_endpoints_.size() / 3,
+                                    debug_scene_.maxgeom);
+    debug_scene_.ngeom = count;
+    const mjtNum* origin = data->cam_xpos + 3 * sensor_mount;
+    const mjtNum* rotation = data->cam_xmat + 9 * sensor_mount;
+    const float color[4] = {0.0f, 0.85f, 1.0f, 0.45f};
+    for (int index = 0; index < count; ++index) {
+      const float x = debug_ray_endpoints_[3*index];
+      const float y = debug_ray_endpoints_[3*index+1];
+      const float z = debug_ray_endpoints_[3*index+2];
+      // ROS lidar (+X forward, +Y left, +Z up) to MuJoCo camera
+      // coordinates (+X right, +Y up, -Z forward).
+      const mjtNum camera[3] = {-y, z, -x};
+      mjtNum endpoint[3] = {
+          origin[0] + rotation[0]*camera[0] + rotation[1]*camera[1] + rotation[2]*camera[2],
+          origin[1] + rotation[3]*camera[0] + rotation[4]*camera[1] + rotation[5]*camera[2],
+          origin[2] + rotation[6]*camera[0] + rotation[7]*camera[1] + rotation[8]*camera[2]};
+      mjvGeom* geom = debug_scene_.geoms + index;
+      mjv_initGeom(geom, mjGEOM_LINE, nullptr, nullptr, nullptr, color);
+      mjv_makeConnector(geom, mjGEOM_LINE, 1.0, origin[0], origin[1], origin[2],
+                        endpoint[0], endpoint[1], endpoint[2]);
+    }
+  }
+  void PublishHeadImu(const mjModel* model, const mjData* data, double wall) {
+    const double period = 1.0 / imu_rate_hz_;
+    if (next_imu_sim_ < -1e20) next_imu_sim_ = data->time;
+    const bool simulation_advanced = data->time > last_imu_sim_ + 1e-12;
+    if (simulation_advanced) {
+      if (data->time + 1e-12 < next_imu_sim_) return;
+      do next_imu_sim_ += period; while (next_imu_sim_ <= data->time);
+    } else if (wall - last_imu_wall_ < period) {
+      return;
+    }
+    last_imu_sim_ = data->time;
+    last_imu_wall_ = wall;
+
+    const int quaternion = mj_name2id(model, mjOBJ_SENSOR, "o2s_imu_quaternion");
+    const int acceleration = mj_name2id(model, mjOBJ_SENSOR, "o2s_imu_linear_acceleration");
+    const int angular_velocity = mj_name2id(model, mjOBJ_SENSOR, "o2s_imu_angular_velocity");
+    if (quaternion < 0 || acceleration < 0 || angular_velocity < 0) return;
+    const mjtNum* q = data->sensordata + model->sensor_adr[quaternion];
+    const mjtNum* a = data->sensordata + model->sensor_adr[acceleration];
+    const mjtNum* w = data->sensordata + model->sensor_adr[angular_velocity];
+    std::ostringstream out;
+    out.imbue(std::locale::classic());
+    out << std::setprecision(16) << "{\"version\":1,\"stamp\":" << wall
+        << ",\"sim_time\":" << data->time << ",\"quaternion_wxyz\":["
+        << q[0] << ',' << q[1] << ',' << q[2] << ',' << q[3]
+        << "],\"linear_acceleration\":[" << a[0] << ',' << a[1] << ',' << a[2]
+        << "],\"angular_velocity\":[" << w[0] << ',' << w[1] << ',' << w[2] << "]}";
+    const auto bytes = out.str();
+    lcm_.publish("lidar/imu", bytes.data(), bytes.size());
+  }
+  void Place(const lcm::ReceiveBuffer* buffer, const std::string&) {
+    if (!model_ || !data_ || buffer->data_size > 100) return;
+    std::istringstream in(std::string(static_cast<const char*>(buffer->data), buffer->data_size));
+    in.imbue(std::locale::classic());
+    std::string tag, extra;
+    double stamp;
+    int side;
+    if (!(in >> tag >> stamp >> side) || (in >> extra) || tag != "PLACE1" ||
+        !std::isfinite(stamp) || WallSeconds() - stamp > 0.5 || stamp - WallSeconds() > 0.1 ||
+        stamp <= last_place_ || (side != -1 && side != 1)) return;
+    const int obstacle = mj_name2id(model_, mjOBJ_BODY, "sudden_obstacle");
+    const int base = mj_name2id(model_, mjOBJ_BODY, "LINK_BASE");
+    if (obstacle < 0 || base < 0) return;
+    const int mocap = model_->body_mocapid[obstacle];
+    if (mocap < 0) return;
+    const mjtNum* p = data_->xpos + 3 * base;
+    const mjtNum* r = data_->xmat + 9 * base;
+    const double yaw = std::atan2(r[3], r[0]);
+    // The sudden-scene robot starts 3 m behind its former position. Place the
+    // box at the former world location: 4.05 m ahead and 0.65 m to either side
