diff --git a/docker/dockerfiles/Dockerfile.glim b/docker/dockerfiles/Dockerfile.glim
new file mode 100644
index 0000000..f8ab487
--- /dev/null
+++ b/docker/dockerfiles/Dockerfile.glim
@@ -0,0 +1,29 @@
+# Optional GLIM extension for the T800 navigation development environment.
+# The EngineAI base image is built first and remains usable without this layer.
+ARG BASE_IMAGE=engineai_robotics_env:humble-desktop-local
+FROM ${BASE_IMAGE}
+
+ARG USER_NAME
+
+USER root
+RUN apt-get update && \
+    apt-get install -y --no-install-recommends ca-certificates curl gpg && \
+    curl -fsSL --compressed \
+        https://koide3.github.io/ppa/ubuntu2204/KEY.gpg \
+        | gpg --dearmor -o /etc/apt/trusted.gpg.d/koide3_ppa.gpg && \
+    echo "deb [signed-by=/etc/apt/trusted.gpg.d/koide3_ppa.gpg] https://koide3.github.io/ppa/ubuntu2204 ./" \
+        > /etc/apt/sources.list.d/koide3_ppa.list && \
+    apt-get update && \
+    apt-get install -y --no-install-recommends \
+        libboost-all-dev \
+        libglfw3-dev \
+        libgtsam-notbb-dev=4.3.0 \
+        libiridescence-dev=1.0.2 \
+        libmetis-dev \
+        libgtsam-points-dev=1.2.2 \
+        ros-humble-glim=1.2.2-0jammy \
+        ros-humble-glim-ros=1.2.2-0jammy && \
+    ldconfig && \
+    rm -rf /var/lib/apt/lists/*
+
+USER ${USER_NAME}
